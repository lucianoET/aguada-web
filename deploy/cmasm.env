# ─────────────────────────────────────────────────────────────────────────────
# Aguada — configuração do site CMASM (Ilha do Engenho)
#
# Servidor: aguada-web (Docker) + gateway ESP-NOW no USB + broker MQTT da stack.
# Home Assistant lê o mesmo broker (entidades por MQTT Discovery do aguada-web).
#
# Instalação no servidor da CMASM:
#   git clone https://github.com/lucianoET/aguada-firmware.git   # reservoirs.yaml
#   git clone https://github.com/lucianoET/aguada-web.git && cd aguada-web
#   cp deploy/cmasm.env .env            # o container lê .env
#   docker compose --env-file deploy/cmasm.env \
#     -f docker-compose.yml -f docker-compose.serial.yml up -d --build
#   → http://<servidor>:${HTTP_PORT}
#
# Home Assistant (VM HAOS):
#   1. Integração MQTT → broker = IP do servidor, porta 1883, sem usuário.
#   2. Copiar HAOS-Lucshouse/homeassistant/packages/aguada.yaml → /config/packages/
#      e dashboards/aguada.yaml → /config/dashboards/; em configuration.yaml:
#        homeassistant: { packages: !include_dir_named packages }
#        lovelace: dashboards: aguada-painel: {mode: yaml, filename: dashboards/aguada.yaml,
#                                              title: Aguada, icon: mdi:water, show_in_sidebar: true}
#   3. Parâmetros (altura útil, offset, volume) editáveis no painel → gravados em reservoirs.yaml.
#
# Rádio: ESP-NOW canal 11 (nodes env *-ch11 / node-c3-ch11, gateway gateway-c3-ch11).
# Reservatórios e node_ids: aguada-firmware/tools/reservoirs.yaml.
# ─────────────────────────────────────────────────────────────────────────────

TZ=America/Sao_Paulo
DATA_DIR=/data

# Porta do painel web (nginx)
HTTP_PORT=80

# Gateway USB — nome em /dev/serial/by-id/ (número de série; não muda com replug).
# Gateway C3 gravado no lucmac (gateway-c3-ch11, MAC 8C:D0:B2:A8:AB:D6):
GATEWAY_SERIAL=usb-Espressif_USB_JTAG_serial_debug_unit_8C:D0:B2:A8:AB:D6-if00
GATEWAY_TRANSPORT=serial

# Broker MQTT: "mqtt" = mosquitto da própria stack (porta 1883 exposta na LAN p/ o HA).
# Se o servidor já tiver um broker, use host.docker.internal e desative o serviço mqtt.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# reservoirs.yaml (pasta, relativa a este repo) — clone do aguada-firmware ao lado
RESERVOIRS_DIR=../aguada-firmware/tools
