SERIAL_PORT=/dev/ttyUSB0
DATA_DIR=/data
TZ=America/Sao_Paulo
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Transport do gateway: auto (padrão), serial ou wifi
# auto  → tenta serial; se falhar, usa WiFi/MQTT; se ambos falharem, tenta de novo
# serial → somente serial (comportamento antigo)
# wifi   → somente MQTT (gateway WiFi)
GATEWAY_TRANSPORT=auto

# Broker MQTT do gateway WiFi (padrão: usa MQTT_HOST acima)
# Defina apenas se o broker do gateway for diferente do broker de publicação
# GW_MQTT_HOST=
# GW_MQTT_PORT=1883
# GW_MQTT_USER=
# GW_MQTT_PASS=
# GW_MQTT_TOPIC=aguada/#
