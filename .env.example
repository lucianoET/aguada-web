# Fuso horário para o scheduler de relatórios
TZ=America/Sao_Paulo

# Porta pública do nginx (padrão: 80)
HTTP_PORT=80

# Gateway via WiFi/MQTT
GATEWAY_TRANSPORT=wifi

# Broker MQTT interno (usado pelo docker-compose.wifi.yml)
# Em Docker, o hostname é o nome do serviço: mqtt
GW_MQTT_HOST=mqtt
GW_MQTT_PORT=1883
# GW_MQTT_USER=
# GW_MQTT_PASS=
# GW_MQTT_TOPIC=aguada/#

# Republicação de leituras processadas no mesmo broker (opcional)
MQTT_HOST=mqtt
MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
